<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Rectangle?>
<AnchorPane xmlns:fx="http://javafx.com/fxml">
    <VBox spacing="15" alignment="TOP_LEFT"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
          styleClass="content-area">
        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>

        <!-- Título principal -->
        <Label text="Mis guardados" styleClass="main-title"/>

        <!-- Controles de filtro -->
        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="searchField" promptText="Buscar por título o autor..." HBox.hgrow="ALWAYS"/>
            <ComboBox fx:id="categoryFilter" promptText="Categoría" prefWidth="180"/>
            <Button text="Limpiar"  styleClass="category-button"/>
        </HBox>

        <!-- Subtítulo -->
        <Label text="Libros guardados" styleClass="section-title"/>

        <!-- Mensaje si no hay libros guardados -->
        <Label fx:id="noSavedLabel" text="No tienes libros guardados aún."
               visible="false" style="-fx-text-fill: gray;"/>

        <!-- Scrollable lista de guardados -->
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <FlowPane fx:id="savedPane" hgap="15" vgap="15" />
            <padding>
                <Insets top="10" bottom="10" left="10" right="10"/>
            </padding>
        </ScrollPane>
        <FlowPane hgap="15" vgap="15">
            <VBox alignment="CENTER" styleClass="book-card">
                <Rectangle width="80" height="100" arcWidth="10" arcHeight="10"
                           style="-fx-fill: #DDD;" />
                <Label text="Nombre libro" />
            </VBox>
            <VBox alignment="CENTER" styleClass="book-card">
                <Rectangle width="80" height="100" arcWidth="10" arcHeight="10"
                           style="-fx-fill: #DDD;" />
                <Label text="Nombre libro" />
            </VBox>
        </FlowPane>
    </VBox>
</AnchorPane>