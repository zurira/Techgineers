<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.shape.Rectangle?>
<BorderPane fx:id="mainPane" xmlns:fx="http://javafx.com/fxml" fx:controller="mx.edu.utez.tt07_dashboard.DashboardController">
    <!-- Sidebar -->
    <left>
        <VBox spacing="20" alignment="TOP_CENTER" styleClass="sidebar">
            <VBox.margin>
                <Insets top="40" left="10" right="10" bottom="20" />
            </VBox.margin>
            <Button fx:id="btnInicio" text="Inicio" styleClass="nav-button" onAction="#goToHome"/>
            <Button fx:id="btnBusqueda" text="Búsqueda" styleClass="nav-button" onAction="#goToSearch"/>
            <Button fx:id="btnGuardados" text="Guardados" styleClass="nav-button" onAction="#goToSaved"/>
            <Button fx:id="btnFavoritos" text="Favoritos" styleClass="nav-button" onAction="#goToFavorites"/>
            <Button fx:id="btnCerrarSesion" text="Cerrar sesión" styleClass="nav-button logout" onAction="#goToLogout"/>
        </VBox>
    </left>
    <!-- Contenido -->
    <center>
    <VBox spacing="15">
        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>

        <Label text="¡Bienvenido!" styleClass="main-title" />

        <!-- Categorias -->
        <HBox spacing="10">
            <Button text="Romance" styleClass="category-button" />
            <Button text="Ficción" styleClass="category-button" />
            <Button text="Deportes" styleClass="category-button" />
            <Button text="Científico" styleClass="category-button" />
            <Button text="Diccionario" styleClass="category-button" />
        </HBox>

        <Label text="Agregados recientemente" styleClass="section-title" />

        <!-- Libros recientes -->
        <FlowPane hgap="15" vgap="15">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <!-- Libros que se agregaran -->
            <VBox alignment="CENTER" styleClass="book-card">
                <Rectangle width="80" height="100" arcWidth="10" arcHeight="10" style="-fx-fill: #DDD;" />
                <Label text="Nombre libro" />
            </VBox>
            <VBox alignment="CENTER" styleClass="book-card">
                <Rectangle width="80" height="100" arcWidth="10" arcHeight="10" style="-fx-fill: #DDD;" />
                <Label text="Nombre libro" />
            </VBox>
        </FlowPane>
    </VBox>
    </center>
</BorderPane>